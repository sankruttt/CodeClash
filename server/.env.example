# CodeClash Backend Environment Configuration

# Server Port
PORT=3001

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/codeclash?retryWrites=true&w=majority

# JWT Authentication Secret (Required)
JWT_SECRET=your_super_secret_jwt_key_here

# Runtime Environment
NODE_ENV=development

# ============================================================
# SMTP (OTP verification email delivery)
# Example below uses Gmail; SMTP_HOST/SMTP_PORT/SMTP_FROM are required.
# - Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
# - SMTP_USER/SMTP_PASS: Gmail App Password (Enable 2FA → App Passwords)
# - SMTP_FROM must match SMTP_USER for Gmail
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=CodeClash <youraccount@gmail.com>
SMTP_REQUIRE_TLS=false

# OTP flow tuning (optional)
# OTP_LIFETIME_MINUTES=5
# OTP_COOLDOWN_SECONDS=60
# OTP_MAX_ATTEMPTS=5
# EMAIL_VERIFIED_TOKEN_EXPIRES_IN=15m

# OnlineCompiler.io Execution API Key (from https://api.onlinecompiler.io)
ONLINE_COMPILER_API_KEY=your_onlinecompiler_api_key_here
ONLINE_COMPILER_API_URL=https://api.onlinecompiler.io/api/run-code-sync/

# ============================================================
# CACHE (leaderboard & match-history)
# Leaderboard & match-history reads are short-TTL cached and are
# invalidated whenever a match is finalized (win/loss/draw,
# forfeit, abandon, timeout, bounty).
#
# REQUIRED for production on Vercel serverless (shared runtimes):
# without these, each warm instance keeps its own in-memory cache
# and freshly-finalized results may take up to the TTL to appear.
#   - Then run `upstash redis credentials add`.
#   - UPSTASH_REDIS_REST_URL  e.g. https://apn1-xxx.upstash.io
#   - UPSTASH_REDIS_REST_TOKEN e.g. AYIAA...~~ (plain, not ENCODED)
#
# Recommended TTLs (optional):
# CACHE_TTL_LEADERBOARD=45
# CACHE_TTL_MATCH_HISTORY=20
# ============================================================
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# CACHE_TTL_LEADERBOARD=45
# CACHE_TTL_MATCH_HISTORY=20
